# Token of the control panel bot, from @BotFather. Turn on Bot Management Mode for it in BotFather's
# Mini App so it can create the other bots; their tokens are kept in $ALFRED_HOME/state/bots/, not here.
TELEGRAM_BOT_TOKEN=replace_me

# Who may talk to Consiglieri: Telegram user ids (preferred) and/or usernames, comma-separated.
# Send /start to the bot from an unlisted account to see that account's id.
ALFRED_ALLOWED_USERS=123456789

# --- Optional -----------------------------------------------------------------
# Where Consiglieri keeps its memory, skills and state. Default: ~/.alfred
# ALFRED_HOME=~/.alfred
# Where the bots Consiglieri creates keep their own directories. Default: next to the home, ~/.alfred-bots.
# Never inside the home: Claude Code would load the main agent's CLAUDE.md into every bot.
# ALFRED_BOTS_HOME=~/.alfred-bots

# Agent backend: claude (default) or codex. Can also be switched per chat with /backend.
# ALFRED_BACKEND=claude
# Which model each backend uses. Leave unset for the backend's own default.
# Claude takes an alias for the latest model (fable, opus, sonnet, haiku) or a full model name.
# A change here applies from the next message, with no restart, and the conversation carries on.
# /status shows the model in use.
# ALFRED_CLAUDE_MODEL=sonnet
# ALFRED_CODEX_MODEL=
# How hard the model thinks. Claude: low, medium, high, xhigh or max. Codex: its
# model_reasoning_effort (for example low, medium, high). Unset means the backend's own setting
# (for Claude, the effort saved in your Claude Code settings for that model). Applies like the model.
# ALFRED_CLAUDE_EFFORT=high
# ALFRED_CODEX_EFFORT=

# Claude Code permission mode for `alfred chat` in the home. Each created bot has its own
# (/bot perm <bot> mode ...), dontAsk by default.
# ALFRED_CLAUDE_PERMISSION_MODE=bypassPermissions
# ALFRED_CODEX_SANDBOX=danger-full-access

# Which browser Consiglieri drives: orca (default), chrome, or none.
#   orca    the browser built into the Orca app. Run `alfred browser-setup` once.
#   chrome  your own Chrome through the Claude in Chrome extension. Claude backend only.
# ALFRED_BROWSER=orca
# With chrome: a Chrome profile kept only for Consiglieri (its folder name). Consiglieri opens it with
# `alfred chrome` when it is closed. Install the Claude extension in that profile only.
# ALFRED_CHROME_PROFILE=Alfred
# ALFRED_CHROME_APP=Google Chrome
# ALFRED_ORCA_BIN=orca
# Extra flags appended to every `claude` call.
# ALFRED_CLAUDE_EXTRA_ARGS=

# Keep one Claude process open per chat, so it can take messages mid-task and wake up by
# itself when a background job ends. Set to 0 to start one process per message instead. Default: 1
# ALFRED_LIVE=1
# Seconds a turn may go without any sign of life before it is stopped. Default: 900
# (With ALFRED_LIVE=0 or the codex backend: the limit for the whole turn.)
# ALFRED_TIMEOUT=900
# Show the tool Consiglieri is currently using as a status message. Default: 1
# ALFRED_PROGRESS=1
# Commit ALFRED_HOME to its own git repo after every turn. Default: 1
# ALFRED_AUTOSAVE=1

# Usage monitor for the Claude plan limits (alfred/usage_monitor.py). When on, it checks the usage alerts
# of bots that have the usage permission, with one /usage reading per cycle (no model call), and wakes
# the bot whose alert holds. Waking a bot is an agent turn and uses plan usage. It sends you nothing yet.
# Off by default; while off, no loop runs and no alert is checked. Bots with the usage permission can still
# ask on-demand questions (alfred usage check, running_low, forecast): one cached /usage reading each. Default: 0
# ALFRED_USAGE_MONITOR=0
# How often it reads the usage while some bot has an alert (at least 5m). Default: 15m
# ALFRED_USAGE_POLL=15m
# The least time between two usage-alert wake-ups of the same bot (at least 5m). Default: 1h
# ALFRED_USAGE_WAKE_INTERVAL=1h
# Percent of the weekly limit one fully used 5-hour window takes, for the weekly forecast (week.surplus).
# Not published by Anthropic; see docs/USAGE_MONITOR_RESEARCH.md, section 10. Default: 8
# When set, it is used as is; when unset, a share measured from the readings replaces the 8 once there is
# enough data (ALFRED_USAGE_CALIBRATE=0 turns that off).
# ALFRED_USAGE_WINDOW_SHARE=8
# ALFRED_USAGE_CALIBRATE=1
# The hours you use Claude, for the weekly forecast: a range, optional days and time zone. Alerts and
# questions can give their own with --hours. Default: every hour of every day
# ALFRED_USAGE_ACTIVE_HOURS=9-20 mon-fri Europe/Madrid
# How a window cut short by the end of the active hours or the weekly reset counts: prorata (by its
# active time) or full (whole, as if it could be used up early). Default: prorata
# ALFRED_USAGE_PARTIAL_WINDOWS=prorata
# A weekly-forecast alert fires once per quota week, and again that week when the loss has grown by this
# many points. Default: the window share (one more window lost)
# ALFRED_USAGE_SURPLUS_STEP=8
# On-demand questions reuse a reading this recent, and after a failed reading wait this long before asking
# /usage again, however many bots ask. Defaults: 5m and 2m
# ALFRED_USAGE_MAX_AGE=5m
# ALFRED_USAGE_RETRY=2m
# Percent used at which `alfred usage running_low` answers true. Default: 90
# ALFRED_USAGE_LOW_THRESHOLD=90

# Personality drafts: in My bots → Personality (and in the creation assistant), "Describe it" has Claude write a
# SOUL.md from a sentence or two. One `claude -p` call per draft, made by the panel itself: no tools, no saved
# session, none of your settings or CLAUDE.md. Nothing is saved until you tap Accept.
# ALFRED_SOUL_MODEL=haiku
# ALFRED_SOUL_EFFORT=low
# Drafts per user per hour (each one is a call, whatever its outcome). Default: 5
# ALFRED_SOUL_ATTEMPTS=5
# ALFRED_SOUL_TIMEOUT=120
